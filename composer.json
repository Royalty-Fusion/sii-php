{
    "name": "royalty-fusion/sii-php",
    "description": "SDK PHP para Facturación Electrónica del SII de Chile (DTE, Boletas, Guías, Notas, Exportación): firma XMLDSig, CAF/TED, validación XSD y de negocio, y Web Services del SII.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sii", "chile", "dte", "factura electronica", "boleta electronica", "xmldsig", "caf", "ted", "symfony"],
    "authors": [
        { "name": "Royalty Fusion" }
    ],
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "psr/cache": "^2.0 || ^3.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-client-contracts": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/cache": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "tecnickcom/tc-lib-barcode": "^2.4"
    },
    "suggest": {
        "symfony/http-kernel": "Para usar el bundle de Symfony (RoyaltyFusion\\Sii\\Bridge\\Symfony\\SiiBundle)",
        "symfony/cache": "Para cachear tokens del SII con un pool PSR-6",
        "tecnickcom/tc-lib-barcode": "Para generar el timbre PDF417 en la representación impresa"
    },
    "autoload": {
        "psr-4": { "RoyaltyFusion\\Sii\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "RoyaltyFusion\\Sii\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
